# OPTIONAL keepalived example. ha-dhcpc now elects and owns the VIP itself;
# use this only when an external supervisor must still drive the role. The
# notify script maps type -> ctl promote/demote.
vrrp_instance data {
	state BACKUP              # both nodes start BACKUP; priority elects
	interface data-if         # the shared L2 segment (VIP shared with data path)
	virtual_router_id 50
	priority 100              # node-a here; node-b: 90
	advert_int 1
	authentication {
		auth_type PASS
		auth_pass changeme
	}
	notify /usr/lib/ha-dhcpc/notify.sh
}
