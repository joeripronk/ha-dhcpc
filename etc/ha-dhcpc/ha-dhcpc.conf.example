# /etc/ha-dhcpc/ha-dhcpc.conf.example — cluster-ready setup.
# Copy to /etc/ha-dhcpc/ha-dhcpc.conf on EVERY cluster member (identical on
# all; the master pushes it to joining nodes). Give each node its own
# /etc/ha-dhcpc/ha-dhcpc-local.conf with priority: (self: is optional there
# and defaults to the node's hostname).
# Enable with: /etc/init.d/ha-dhcpc enable && /etc/init.d/ha-dhcpc start
designated_master: node-a
master_mac: "aa:bb:cc:dd:ee:ff"        # the single DHCP client identity,
                                        # byte-identical on every member
members:
  - { id: node-a, sync_address: 10.10.0.1 }   # distinct per-node secondary
  - { id: node-b, sync_address: 10.10.0.2 }   # addrs on the shared link
  - { id: node-c, sync_address: 10.10.0.3 }

interface: eth0              # DHCP/data interface (adjust per platform)
cluster:
  port: 4227
  heartbeat_ms: 2000
  election_deadline_ms: 6000  # dead-master timeout before failover
  quorum: majority             # majority | none (two-node clusters need none)
  preempt: true                # converge on the best live master (off = elect
  # only when no live master is present)
  cluster_timeout_ms: 0        # default-role bootstrap deadline (0=off)
  # addresses:                 # VIPs owned by the master, keyed by interface
  #   br-lan: [192.168.10.1/24] # CIDR or dotted netmask
default_role: slave            # master = bootstrap election when no master
                               # is known; election by priority, ties by id
dhcp:
  retention: forever           # keep the last good config when DHCP fails
  rediscover_in_retention: true
  rate_limit_ms: 10000         # min ms between sent DHCP packets
                               # (required for Odido NL fiber, >= 10 s)
  renew_retry_interval_s: 30
  request_options: [1, 3, 6, 15, 26, 28, 42, 121]
apply:
  routes: true
  # backup_gateway: 192.168.10.1  # slave-only backup default route (higher
                                  # metric, removed on promotion); usually set
                                  # per node in ha-dhcpc-local.conf
  # master_backup_gateway: 192.168.10.3  # master-only: takes over the default
                                  # route while the gateway probe is unanswered
                                  # or there is no lease IP yet
  gateway_probe: true            # ping lease gateway for liveness (master-only)
  gateway_probe_interval_ms: 10000  # probe interval (ms)
  gateway_probe_timeout_ms: 2000    # reply timeout (ms)
  gateway_probe_fail_threshold: 3   # consecutive misses -> unreachable/failover
  suppress_member_dad: true    # compatibility no-op
  arp_responder: true          # compatibility no-op (the VIP owner answers)
  announce_gratuitous: true    # gratuitous ARP on promotion
  abort_tcp_on_newip: false    # ctl newip: when a new IP is obtained, abort
                               # established TCP connections using the old one
  # slave_isolation: down      # none|down|nft (nft: block all egress via
                               # netdev hook, link stays up; tcpdump sees it).
                               # slave_link_down: true = legacy alias for down.
ctl_socket: /tmp/ha-dhcpc.ctl
loglevel: info                 # debug | info | warn | err
