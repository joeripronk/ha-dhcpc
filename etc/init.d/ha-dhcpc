#!/bin/sh /etc/rc.common
# ha-dhcpc daemon: reads /etc/ha-dhcpc/ha-dhcpc.conf (cluster-shared) and
# /etc/ha-dhcpc/ha-dhcpc-local.conf (per-node overlay). Copy
# /etc/ha-dhcpc/ha-dhcpc.conf.example first and enable on every cluster member.

START=95
STOP=10

USE_PROCD=1

start_service() {
	[ -f /etc/ha-dhcpc/ha-dhcpc.conf ] || {
		echo "ha-dhcpc: /etc/ha-dhcpc/ha-dhcpc.conf missing (copy ha-dhcpc.conf.example)" >&2
		return 1
	}

	procd_open_instance ha-dhcpc
	if [ -f /etc/ha-dhcpc/valgrind.enabled ] && [ -x /usr/bin/valgrind ]; then
		procd_set_param command /usr/bin/valgrind --tool=memcheck --leak-check=full --show-leak-kinds=all --track-origins=yes --log-file=/tmp/ha-dhcpc-valgrind.log /usr/bin/ha-dhcpc
	else
		procd_set_param command /usr/bin/ha-dhcpc
	fi
	procd_set_param respawn 3600 5 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
